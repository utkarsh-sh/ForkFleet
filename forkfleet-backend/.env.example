# ── Server ──────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_VERSION=v1

# ── PostgreSQL ───────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=forkfleet
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_POOL_MIN=2
DB_POOL_MAX=10

# ── Redis ────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CART_TTL=3600          # cart session TTL in seconds (1 hour)

# ── JWT ──────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_min_64_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=another_long_random_secret_for_refresh_tokens
JWT_REFRESH_EXPIRES_IN=30d

# ── Razorpay ─────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ── App Logic ────────────────────────────────────────
DELIVERY_FEE_PER_RESTAURANT=30   # ₹30 per restaurant in order
TAX_RATE=0.05                    # 5% GST
MAX_RESTAURANTS_PER_ORDER=5
MAX_ITEMS_PER_ORDER=50
RIDER_ASSIGNMENT_RADIUS_KM=10

# ── Logging ──────────────────────────────────────────
LOG_LEVEL=info
